# LOCAL DEVELOPMENT ONLY. Replace all secrets before public deployment.
POSTGRES_DB=karaboz_cloud
POSTGRES_USER=karaboz
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://karaboz:change-this-local-password@postgres:5432/karaboz_cloud?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-bytes
S3_ENDPOINT=http://seaweedfs:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=karaboz-local-access
S3_SECRET_KEY=replace-this-local-s3-secret
API_ADDR=:8080
MAX_UPLOAD_BYTES=26214400
DEFAULT_PROJECT_QUOTA_BYTES=1073741824
DEFAULT_PROJECT_BUCKET_LIMIT=10
CORS_ALLOWED_ORIGIN=http://localhost:4173
VITE_API_BASE=http://localhost:8080
